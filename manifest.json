{
  "manifest_version": 3,
  "name": "Readmark",
  "version": "1.0.0",
  "description": "place bookmark in AI conversations and quickly jump back to them",
  "permissions": ["activeTab", "storage"],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}
